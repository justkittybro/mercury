-- ScriptBlox Logic:
local function notify(title, text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = 3
		})
	end)
end

local function httpGet(url)
	if game.HttpGet then
		return game:HttpGet(url)
	end
	return HttpService:GetAsync(url)
end

local function urlEncode(str)
	return (str:gsub("([^%w%-_%.~])", function(c)
		return string.format("%%%02X", string.byte(c))
	end))
end

local function updateCanvas()
	Quickactions.CanvasSize = UDim2.fromOffset(0, UIListLayout.AbsoluteContentSize.Y + 16)
end

UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)

local function clearResultCards()
	for _, child in ipairs(Quickactions:GetChildren()) do
		if child:IsA("Frame") and child.Name == "ScriptResultCard" then
			child:Destroy()
		end
	end
	updateCanvas()
end

local function getLoadstringText(item)
	if type(item.script) == "string" and item.script:match("%S") then
		return item.script
	end

	local idOrSlug = item.slug or item._id
	if idOrSlug then
		return string.format(
			'loadstring(game:HttpGet("https://scriptblox.com/raw/%s"))()',
			tostring(idOrSlug)
		)
	end

	return ""
end

local function executeScriptCode(titleText, codeText)
	if codeText == "" then
		warn("Error running script:", "Empty payload for " .. titleText)
		notify("Mercury X", "No script code for " .. titleText)
		return
	end

	if not loadstring then
		warn("Error running script: loadstring is not available in this environment.")
		notify("Mercury X", "loadstring not available here")
		return
	end

	local success, err = pcall(function()
		loadstring(codeText)()
	end)

	if not success then
		warn("Error running script:", err)
		notify("Mercury X", "Error running script")
	end
end

local function copyScriptCode(titleText, codeText)
	if codeText == "" then
		warn("Nothing to copy for:", titleText)
		notify("Mercury X", "Nothing to copy")
		return
	end

	if not setclipboard then
		warn("setclipboard is not available in this environment.")
		notify("Mercury X", "setclipboard not available here")
		return
	end

	setclipboard(codeText)
	notify("Mercury X", "Copied: " .. titleText)
end

local function viewScriptCode(titleText, codeText)
	ViewTitle.Text = titleText
	ViewBox.Text = codeText ~= "" and codeText or "-- No script code available"
	ViewModal.Visible = true
end

local function renderSearchResults(scriptsList)
	clearResultCards()

	if type(scriptsList) ~= "table" or #scriptsList == 0 then
		local emptyCard = Frame_13:Clone()
		emptyCard.Name = "ScriptResultCard"
		emptyCard.Visible = true
		emptyCard.Parent = Quickactions

		local titleLbl = emptyCard:FindFirstChildWhichIsA("TextLabel", true)
		if titleLbl then
			titleLbl.Text = "No scripts found"
		end

		for _, btn in ipairs(emptyCard:GetDescendants()) do
			if btn:IsA("TextButton") then
				btn.Visible = false
			end
		end

		updateCanvas()
		return
	end

	for _, item in ipairs(scriptsList) do
		local card = Frame_13:Clone()
		card.Name = "ScriptResultCard"
		card.Visible = true
		card.Parent = Quickactions

		local titleText = item.title or "Untitled"
		local codeText = getLoadstringText(item)

		local titleLbl = card:FindFirstChildWhichIsA("TextLabel", true)
		if titleLbl then
			titleLbl.Text = titleText
		end

		local execBtn = card:FindFirstChild("TextButton_5")
		local copyBtn = card:FindFirstChild("TextButton_6")
		local viewBtn = card:FindFirstChild("TextButton_7")

		if execBtn then
			execBtn.Active = true
			execBtn.ZIndex = 10
			execBtn.MouseButton1Click:Connect(function()
				executeScriptCode(titleText, codeText)
			end)
		end

		if copyBtn then
			copyBtn.Active = true
			copyBtn.ZIndex = 10
			copyBtn.MouseButton1Click:Connect(function()
				copyScriptCode(titleText, codeText)
			end)
		end

		if viewBtn then
			viewBtn.Active = true
			viewBtn.ZIndex = 10
			viewBtn.MouseButton1Click:Connect(function()
				viewScriptCode(titleText, codeText)
			end)
		end
	end

	updateCanvas()
end

local function searchScriptBlox(query)
	local trimmed = (query or ""):match("^%s*(.-)%s*$")
	local url = trimmed ~= ""
		and ("https://scriptblox.com/api/script/search?q=" .. urlEncode(trimmed) .. "&max=20&mode=free")
		or "https://scriptblox.com/api/script/fetch?max=20&mode=free"

	local okGet, body = pcall(httpGet, url)
	if not okGet or type(body) ~= "string" then
		warn("ScriptBlox request failed:", body)
		return
	end

	local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, body)
	if not okDecode or type(decoded) ~= "table" or not decoded.result or type(decoded.result.scripts) ~= "table" then
		warn("Failed to parse ScriptBlox JSON.")
		return
	end

	renderSearchResults(decoded.result.scripts)
end

TextBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		searchScriptBlox(TextBox.Text)
	end
end)

task.spawn(function()
	searchScriptBlox("")
end)
