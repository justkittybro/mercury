-- Scripts:

local HttpService = game:GetService("HttpService")

local mainFrame = MercuryExecutor:WaitForChild("MainFrame")
local resultsContainer = mainFrame:WaitForChild("Quickactions")
local searchBox = resultsContainer:FindFirstChildWhichIsA("TextBox", true)
local cardTemplate = resultsContainer:FindFirstChild("Frame_13", true)
local listLayout = resultsContainer:FindFirstChildWhichIsA("UIListLayout", true)

resultsContainer.ZIndex = 5
cardTemplate.Visible = false

local function httpGet(url)
	if game.HttpGet then
		return game:HttpGet(url)
	end
	return HttpService:GetAsync(url)
end

local function urlEncode(str)
	return (str:gsub("([^%w%-_%.~])", function(c)
		return string.format("%%%02X", string.byte(c))
	end))
end

local function updateCanvas()
	if listLayout then
		resultsContainer.CanvasSize = UDim2.fromOffset(0, listLayout.AbsoluteContentSize.Y + 16)
	end
end

if listLayout then
	listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateCanvas)
end

local function clearResultCards()
	for _, child in ipairs(resultsContainer:GetChildren()) do
		if child:IsA("Frame") and child.Name == "ScriptResultCard" then
			child:Destroy()
		end
	end
	updateCanvas()
end

local function getLoadstringText(item)
	if type(item.script) == "string" and item.script:match("%S") then
		return item.script
	end

	local idOrSlug = item.slug or item._id
	if idOrSlug then
		return string.format(
			'loadstring(game:HttpGet("https://scriptblox.com/raw/%s"))()',
			tostring(idOrSlug)
		)
	end

	return ""
end

local function findButtonByText(card, targetText)
	for _, obj in ipairs(card:GetDescendants()) do
		if obj:IsA("TextButton") then
			local clean = obj.Text:gsub("%s+", ""):lower()
			if clean == targetText:lower() then
				return obj
			end
		end
	end
	return nil
end

local function renderSearchResults(scriptsList)
	clearResultCards()

	if type(scriptsList) ~= "table" or #scriptsList == 0 then
		local emptyCard = cardTemplate:Clone()
		emptyCard.Name = "ScriptResultCard"
		emptyCard.Visible = true
		emptyCard.Parent = resultsContainer

		local titleLbl = emptyCard:FindFirstChildWhichIsA("TextLabel", true)
		if titleLbl then
			titleLbl.Text = "No scripts found"
		end

		for _, btn in ipairs(emptyCard:GetDescendants()) do
			if btn:IsA("TextButton") then
				btn.Visible = false
			end
		end

		updateCanvas()
		return
	end

	for _, item in ipairs(scriptsList) do
		local card = cardTemplate:Clone()
		card.Name = "ScriptResultCard"
		card.Visible = true
		card.Parent = resultsContainer

		local titleText = item.title or "Untitled"
		local codeText = getLoadstringText(item)

		local titleLbl = card:FindFirstChildWhichIsA("TextLabel", true)
		if titleLbl then
			titleLbl.Text = titleText
		end

		local execBtn = findButtonByText(card, "Execute")
		local copyBtn = findButtonByText(card, "Copy")

		if execBtn then
			execBtn.MouseButton1Click:Connect(function()
				print("[MercuryHub] Execute clicked:", titleText)
				if codeText == "" then
					warn("Error running script: empty script payload")
					return
				end
				if not loadstring then
					warn("Error running script: loadstring unavailable")
					return
				end
				local success, err = pcall(function()
					loadstring(codeText)()
				end)
				if not success then
					warn("Error running script:", err)
				end
			end)
		else
			warn("[MercuryHub] Execute button not found in card")
		end

		if copyBtn then
			copyBtn.MouseButton1Click:Connect(function()
				print("[MercuryHub] Copy clicked:", titleText)
				if codeText == "" then
					warn("Error copying script: empty script payload")
					return
				end
				if not setclipboard then
					warn("Error copying script: setclipboard unavailable")
					return
				end
				setclipboard(codeText)
			end)
		else
			warn("[MercuryHub] Copy button not found in card")
		end
	end

	updateCanvas()
end

local function searchScriptBlox(query)
	local trimmed = (query or ""):match("^%s*(.-)%s*$")
	local url = trimmed ~= ""
		and ("https://scriptblox.com/api/script/search?q=" .. urlEncode(trimmed) .. "&max=20&mode=free")
		or "https://scriptblox.com/api/script/fetch?max=20&mode=free"

	local okGet, body = pcall(httpGet, url)
	if not okGet or type(body) ~= "string" then
		warn("ScriptBlox request failed:", body)
		return
	end

	local okDecode, decoded = pcall(HttpService.JSONDecode, HttpService, body)
	if not okDecode or type(decoded) ~= "table" or not decoded.result or type(decoded.result.scripts) ~= "table" then
		warn("Failed to parse ScriptBlox JSON.")
		return
	end

	renderSearchResults(decoded.result.scripts)
end

searchBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		searchScriptBlox(searchBox.Text)
	end
end)

task.spawn(function()
	searchScriptBlox("")
end)
