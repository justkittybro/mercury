--========================================================
-- Football Teleport + Auto Toggle (0 Delay)
-- Teleports YOU to the Football
--========================================================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Player = Players.LocalPlayer
local AutoTeleportEnabled = false
--========================================================
-- CREATE UI
--========================================================
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FootballTP"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = Player:WaitForChild("PlayerGui")
local Main = Instance.new("Frame")
Main.Size = UDim2.new(0, 280, 0, 140)
Main.Position = UDim2.new(0.5, -140, 0.15, 0)
Main.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
Main.BorderSizePixel = 0
Main.Active = true
Main.Parent = ScreenGui
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 12)
-- Title
local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 36)
Title.BackgroundTransparency = 1
Title.Text = "Football Teleport"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.TextScaled = true
Title.Font = Enum.Font.GothamBold
Title.Parent = Main
-- Teleport Button (Manual)
local TPButton = Instance.new("TextButton")
TPButton.Size = UDim2.new(0.48, -10, 0, 40)
TPButton.Position = UDim2.new(0, 15, 0, 50)
TPButton.BackgroundColor3 = Color3.fromRGB(40, 140, 255)
TPButton.Text = "Teleport"
TPButton.TextColor3 = Color3.new(1, 1, 1)
TPButton.TextScaled = true
TPButton.Font = Enum.Font.GothamBold
TPButton.BorderSizePixel = 0
TPButton.Parent = Main
Instance.new("UICorner", TPButton).CornerRadius = UDim.new(0, 8)
-- Auto Toggle Button
local AutoButton = Instance.new("TextButton")
AutoButton.Size = UDim2.new(0.48, -10, 0, 40)
AutoButton.Position = UDim2.new(0.52, 0, 0, 50)
AutoButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
AutoButton.Text = "Auto: OFF"
AutoButton.TextColor3 = Color3.new(1, 1, 1)
AutoButton.TextScaled = true
AutoButton.Font = Enum.Font.GothamBold
AutoButton.BorderSizePixel = 0
AutoButton.Parent = Main
Instance.new("UICorner", AutoButton).CornerRadius = UDim.new(0, 8)
-- Status
local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -30, 0, 28)
Status.Position = UDim2.new(0, 15, 0, 100)
Status.BackgroundTransparency = 1
Status.Text = "Ready"
Status.TextColor3 = Color3.fromRGB(160, 160, 160)
Status.TextScaled = true
Status.Font = Enum.Font.Gotham
Status.Parent = Main
--========================================================
-- FIND FOOTBALL + TELEPORT
--========================================================
local function FindFootball()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("MeshPart") or obj:IsA("BasePart") or obj:IsA("Part")) and obj.Name == "Football" then
            return obj
        end
    end
    return nil
end
local function DoTeleport(ball)
    local character = Player.Character
    if not character then return false end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    -- Teleport player to the football
    root.CFrame = CFrame.new(ball.Position + Vector3.new(0, 5, 0))
    return true
end
local function ManualTeleport()
    local ball = FindFootball()
    if not ball then
        Status.Text = "Football not found"
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    if DoTeleport(ball) then
        Status.Text = "Teleported to Football"
        Status.TextColor3 = Color3.fromRGB(80, 220, 100)
    end
end
--========================================================
-- BUTTONS
--========================================================
TPButton.MouseButton1Click:Connect(ManualTeleport)
AutoButton.MouseButton1Click:Connect(function()
    AutoTeleportEnabled = not AutoTeleportEnabled
    if AutoTeleportEnabled then
        AutoButton.BackgroundColor3 = Color3.fromRGB(40, 180, 60)
        AutoButton.Text = "Auto: ON"
        Status.Text = "Auto Teleport ON (0 Delay)"
        Status.TextColor3 = Color3.fromRGB(80, 220, 100)
    else
        AutoButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        AutoButton.Text = "Auto: OFF"
        Status.Text = "Auto Teleport OFF"
        Status.TextColor3 = Color3.fromRGB(160, 160, 160)
    end
end)
--========================================================
-- AUTO TELEPORT (0 DELAY)
--========================================================
RunService.Heartbeat:Connect(function()
    if not AutoTeleportEnabled then return end
    local ball = FindFootball()
    if ball then
        DoTeleport(ball)
    end
end)
--========================================================
-- DRAGGING
--========================================================
local dragging, dragStart, startPos = false, nil, nil
Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)
Main.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
print("Football Teleport loaded")
