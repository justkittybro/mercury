local function ORJVJ_fake_script() -- TextButton.LocalScript 
	local script = Instance.new('LocalScript', TextButton)

	--========================================================
	-- Football Auto Teleport (Studio Button)
	-- Red = OFF | Green = ON
	--========================================================
	
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Player = Players.LocalPlayer
	
	local Button = script.Parent
	local AutoEnabled = false
	
	-- Button setup
	Button.Size = UDim2.new(0, 160, 0, 50)
	Button.Position = UDim2.new(0.5, -80, 0.85, 0)
	Button.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Red (OFF)
	Button.Text = ""
	Button.TextColor3 = Color3.new(1, 1, 1)
	Button.TextScaled = true
	Button.Font = Enum.Font.GothamBold
	Button.BorderSizePixel = 0
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = Button
	
	--========================================================
	-- FIND FOOTBALL + TELEPORT
	--========================================================
	
	local function FindFootball()
		for _, obj in ipairs(workspace:GetDescendants()) do
			if (obj:IsA("MeshPart") or obj:IsA("BasePart") or obj:IsA("Part")) and obj.Name == "Football" then
				return obj
			end
		end
		return nil
	end
	
	local function DoTeleport(ball)
		local character = Player.Character
		if not character then return end
	
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then return end
	
		root.CFrame = CFrame.new(ball.Position + Vector3.new(0, 5, 0))
	end
	
	--========================================================
	-- TOGGLE BUTTON
	--========================================================
	
	Button.MouseButton1Click:Connect(function()
		AutoEnabled = not AutoEnabled
	
		if AutoEnabled then
			Button.BackgroundColor3 = Color3.fromRGB(40, 180, 60) -- Green
			Button.Text = ""
		else
			Button.BackgroundColor3 = Color3.fromRGB(200, 50, 50) -- Red
			Button.Text = ""
		end
	end)
	
	--========================================================
	-- AUTO LOOP (0 DELAY)
	--========================================================
	
	RunService.Heartbeat:Connect(function()
		if not AutoEnabled then return end
	
		local ball = FindFootball()
		if ball then
			DoTeleport(ball)
		end
	end)
	
	print("Football Auto Teleport button loaded")
end
